<!-- Pricing comparison table — verbatim extraction. -->
  <section id="harga" class="py-section">
    <div class="section-inner">

      <div class="pricing-header reveal">
        <div class="section-eyebrow"><span class="section-eyebrow-dot"></span>Harga</div>
        <h2>Transparan, sederhana,<br><span class="accent">tanpa biaya tersembunyi.</span></h2>
        <p>Semua harga sudah termasuk PPN. Tidak ada biaya tambahan atau potongan tersembunyi.</p>
      </div>

      <!-- Two plan cards -->
      <div class="pricing-plans-grid">
        <!-- STARTER -->
        <div class="plan-card-wrapper reveal delay-1">
          <div class="plan-card plan-card-starter">
            <div class="plan-discount-badge starter-badge"><span class="plan-discount-icon">🏷</span> DISKON 10%</div>
            <div class="plan-old-price">Rp 149.000</div>
            <div class="plan-tier">STARTER</div>
            <div class="plan-price">Rp 134.000<span>/bulan</span></div>
            <div class="plan-saving">Hemat Rp 15.000!</div>
            <a href="https://admin.amora.id/" class="plan-cta outline-cta">Mulai Starter</a>
          </div>
        </div>
        <!-- PRO -->
        <div class="plan-card-wrapper reveal delay-2">
          <span class="plan-ribbon">Rekomendasi</span>
          <div class="plan-card plan-card-pro">
            <div class="plan-discount-badge pro-badge"><span class="plan-discount-icon">🔥</span> DISKON 40%</div>
            <div class="plan-old-price">Rp 349.000</div>
            <div class="plan-tier">PRO</div>
            <div class="plan-price">Rp 209.000<span>/bulan</span></div>
            <div class="plan-saving">Hemat Rp 140.000!</div>
            <a href="https://admin.amora.id/" class="plan-cta filled-cta">Mulai Pro</a>
          </div>
        </div>
      </div>

      <!-- Comparison table -->
      <div class="pricing-table reveal delay-2">
        <table>
          <thead>
            <tr>
              <th>FITUR</th>
              <th class="th-starter">Starter</th>
              <th class="th-pro">Pro</th>
            </tr>
          </thead>
          <tbody>
            <!-- TOKO & TAMPILAN -->
            <tr class="cat-row">
              <td colspan="3">Toko &amp; Tampilan</td>
            </tr>
            <tr>
              <td class="feat-name">Kustomisasi Desain Toko</td>
              <td class="feat-val"><span class="pill-limited">Terbatas</span></td>
              <td class="feat-val"><span class="pill-full">Fitur Lengkap</span></td>
            </tr>
            <tr>
              <td class="feat-name">Integrasi Domain Kustom</td>
              <td class="feat-val"><svg class="check-icon" data-icon viewBox="0 0 24 24" width="20" height="20">
                  <polyline points="20 6 9 17 4 12" />
                </svg></td>
              <td class="feat-val"><svg class="check-icon" data-icon viewBox="0 0 24 24" width="20" height="20">
                  <polyline points="20 6 9 17 4 12" />
                </svg></td>
            </tr>
            <tr>
              <td class="feat-name">Penjadwalan Peluncuran Produk</td>
              <td class="feat-val"><svg class="cross-icon" data-icon viewBox="0 0 24 24" width="20" height="20">
                  <line x1="18" y1="6" x2="6" y2="18" />
                  <line x1="6" y1="6" x2="18" y2="18" />
                </svg></td>
              <td class="feat-val"><svg class="check-icon" data-icon viewBox="0 0 24 24" width="20" height="20">
                  <polyline points="20 6 9 17 4 12" />
                </svg></td>
            </tr>

            <!-- PRODUK & INVENTORI -->
            <tr class="cat-row">
              <td colspan="3">Produk &amp; Inventori</td>
            </tr>
            <tr>
              <td class="feat-name">Jumlah Produk</td>
              <td class="feat-val blue-val">Maks. 100 produk</td>
              <td class="feat-val accent-val">Maks. 250 produk</td>
            </tr>
            <tr>
              <td class="feat-name">
                Opsi Produk
                <small>Pilihan variasi yang bisa dipilih pembeli (mis. ukuran, warna, bahan)</small>
              </td>
              <td class="feat-val blue-val">Maks. 2 opsi</td>
              <td class="feat-val accent-val">Maks. 3 opsi</td>
            </tr>
            <tr>
              <td class="feat-name">Koleksi Produk</td>
              <td class="feat-val blue-val">Maks. 10 koleksi</td>
              <td class="feat-val accent-val">Maks. 25 koleksi</td>
            </tr>
            <tr>
              <td class="feat-name">Variasi per Produk</td>
              <td class="feat-val blue-val">Maks. 256 variasi</td>
              <td class="feat-val accent-val">Maks. 512 variasi</td>
            </tr>
            <tr>
              <td class="feat-name">Pengaturan Diskon Produk</td>
              <td class="feat-val"><svg class="check-icon" data-icon viewBox="0 0 24 24" width="20" height="20">
                  <polyline points="20 6 9 17 4 12" />
                </svg></td>
              <td class="feat-val"><svg class="check-icon" data-icon viewBox="0 0 24 24" width="20" height="20">
                  <polyline points="20 6 9 17 4 12" />
                </svg></td>
            </tr>

            <!-- KATEGORI PRODUK -->
            <tr class="cat-row">
              <td colspan="3">Kategori Produk</td>
            </tr>
            <tr>
              <td class="feat-name">
                Kategori Induk
                <small>Kelompok kategori utama (mis. Pakaian, Elektronik)</small>
              </td>
              <td class="feat-val blue-val">Maks. 10 kategori</td>
              <td class="feat-val accent-val">Maks. 10 kategori</td>
            </tr>
            <tr>
              <td class="feat-name">
                Kategori Anak
                <small>Sub-kategori di dalam kategori induk (mis. Pakaian → Kaos, Celana)</small>
              </td>
              <td class="feat-val"><span class="pill-limited">Tidak tersedia</span></td>
              <td class="feat-val accent-val">Maks. 10 per induk</td>
            </tr>

            <!-- VOUCHER -->
            <tr class="cat-row">
              <td colspan="3">Voucher</td>
            </tr>
            <tr>
              <td class="feat-name">
                Voucher Aktif
                <small>Jumlah voucher diskon yang bisa aktif sekaligus</small>
              </td>
              <td class="feat-val blue-val">Maks. 5 voucher</td>
              <td class="feat-val accent-val">Maks. 15 voucher</td>
            </tr>
            <tr>
              <td class="feat-name">
                Kombinasi Voucher
                <small>Berapa banyak voucher berbeda yang bisa dipakai sekaligus dalam 1 transaksi</small>
              </td>
              <td class="feat-val blue-val">Maks. 2 kombinasi</td>
              <td class="feat-val accent-val">Maks. 5 kombinasi</td>
            </tr>
            <tr>
              <td class="feat-name">
                Whitelist Kombinasi Voucher
                <small>Atur sendiri voucher mana saja yang boleh dipakai bersama (dikombinasikan)</small>
              </td>
              <td class="feat-val"><svg class="cross-icon" data-icon viewBox="0 0 24 24" width="20" height="20">
                  <line x1="18" y1="6" x2="6" y2="18" />
                  <line x1="6" y1="6" x2="18" y2="18" />
                </svg></td>
              <td class="feat-val"><svg class="check-icon" data-icon viewBox="0 0 24 24" width="20" height="20">
                  <polyline points="20 6 9 17 4 12" />
                </svg></td>
            </tr>

            <!-- PESANAN -->
            <tr class="cat-row">
              <td colspan="3">Pesanan</td>
            </tr>
            <tr>
              <td class="feat-name">
                Kuota Transaksi Bulanan
                <small>sudah termasuk dalam paket</small>
              </td>
              <td class="feat-val blue-val">300 pesanan<br><span
                  style="font-size:0.75rem;font-weight:400;color:var(--text-40)">per bulan</span></td>
              <td class="feat-val accent-val">1.000 pesanan<br><span
                  style="font-size:0.75rem;font-weight:400;color:var(--text-40)">per bulan</span></td>
            </tr>
            <tr>
              <td class="feat-name">
                Biaya Kelebihan Kuota
                <small>dikenakan per pesanan di atas kuota</small>
              </td>
              <td class="feat-val blue-val">2% per pesanan</td>
              <td class="feat-val accent-val">1% per pesanan</td>
            </tr>

            <!-- PEMBAYARAN & PENGIRIMAN -->
            <tr class="cat-row">
              <td colspan="3">Pembayaran &amp; Pengiriman</td>
            </tr>
            <tr>
              <td class="feat-name">
                Integrasi Payment Gateway Lokal
                <small>Xendit, Doku, Midtrans</small>
              </td>
              <td class="feat-val"><svg class="check-icon" data-icon viewBox="0 0 24 24" width="20" height="20">
                  <polyline points="20 6 9 17 4 12" />
                </svg></td>
              <td class="feat-val"><svg class="check-icon" data-icon viewBox="0 0 24 24" width="20" height="20">
                  <polyline points="20 6 9 17 4 12" />
                </svg></td>
            </tr>
            <tr>
              <td class="feat-name">Cek Ongkir, Cetak Resi &amp; Pelacakan Pengiriman</td>
              <td class="feat-val"><svg class="check-icon" data-icon viewBox="0 0 24 24" width="20" height="20">
                  <polyline points="20 6 9 17 4 12" />
                </svg></td>
              <td class="feat-val"><svg class="check-icon" data-icon viewBox="0 0 24 24" width="20" height="20">
                  <polyline points="20 6 9 17 4 12" />
                </svg></td>
            </tr>
          </tbody>
          <tfoot>
            <tr>
              <td>
                <p class="pricing-note">* Harga sudah termasuk PPN</p>
              </td>
              <td class="tfoot-cta tfoot-cta-starter"><a href="https://admin.amora.id/">Starter</a></td>
              <td class="tfoot-cta tfoot-cta-pro"><a href="https://admin.amora.id/">Pro</a></td>
            </tr>
          </tfoot>
        </table>
      </div>

    </div>
  </section>
