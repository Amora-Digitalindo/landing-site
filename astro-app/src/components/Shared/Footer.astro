---
// Shared footer. Differences between landing & legal, verified against both
// source files:
//  - "Amora.id" column links are in-page anchors on landing, cross-page on legal
//  - .footer-grid has the .reveal scroll-animation class only on landing
//  - copyright year is 2025 on landing, 2026 on legal (kept as an explicit
//    prop default rather than hardcoding "current year" logic that doesn't
//    exist in the original markup)
export interface Props {
  variant?: 'landing' | 'legal';
  year?: number;
}

const { variant = 'landing', year = variant === 'landing' ? 2025 : 2026 } = Astro.props;
const base = variant === 'legal' ? 'amora-landing-v2.html' : '';
const homeHref = variant === 'legal' ? 'amora-landing-v2.html' : '#';
---

<footer>
  <div class="footer-inner">
    <div class:list={['footer-grid', { reveal: variant === 'landing' }]}>
      <div class="footer-brand">
        <img src="./asset/logo.png" alt="Amora.id">
        <p>Solusi Website Jualan untuk Bisnis Modern Indonesia</p>
        <small>© {year} Amora.id. Hak cipta dilindungi.</small>
      </div>
      <div class="footer-col">
        <h4>Amora.id</h4>
        <ul>
          <li><a href={homeHref}>About Amora</a></li>
          <li><a href={`${base}#fitur`}>Fitur</a></li>
          <li><a href={`${base}#harga`}>Harga</a></li>
          <li><a href={`${base}#faq`}>FAQ</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Panduan</h4>
        <ul>
          <li><a href="syarat.html">Syarat &amp; Ketentuan</a></li>
          <li><a href="privasi.html">Kebijakan Privasi</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Kontak</h4>
        <ul style="gap:14px">
          <li class="footer-contact-item">
            <svg data-icon viewBox="0 0 24 24">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
              <polyline points="22,6 12,13 2,6" />
            </svg>
            <a href="mailto:support@amora.id">support@amora.id</a>
          </li>
          <li class="footer-contact-item">
            <svg data-icon viewBox="0 0 24 24">
              <path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.38 2 2 0 0 1 3.58 1.22h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.96a16 16 0 0 0 6.13 6.13l1.32-1.32a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
            <a href="tel:+6287832011500">0878 3201 1500</a>
          </li>
          <li class="footer-social">
            <a href="#" aria-label="Instagram">
              <svg data-icon viewBox="0 0 24 24">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
              </svg>
            </a>
            <a href="#" aria-label="Threads">
              <svg data-icon viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="1" />
                <path
                  d="M12 2a10 10 0 0 1 10 10 10 10 0 0 1-10 10A10 10 0 0 1 2 12 10 10 0 0 1 12 2m0 2a8 8 0 0 0-8 8 8 8 0 0 0 8 8 8 8 0 0 0 8-8 8 8 0 0 0-8-8z" />
                <path
                  d="M12 7a1 1 0 0 1 0 2 1 1 0 0 1 0-2m0 4a1 1 0 0 1 0 2 1 1 0 0 1 0-2m0 4a1 1 0 0 1 0 2 1 1 0 0 1 0-2" />
              </svg>
            </a>
            <a href="#" aria-label="WhatsApp">
              <svg data-icon viewBox="0 0 24 24">
                <path
                  d="M12 2C6.48 2 2 6.48 2 12c0 1.54.36 3.01.97 4.31L2 22l6.31-.97C9.99 23.64 11.46 24 13 24c5.52 0 10-4.48 10-10S17.52 2 12 2zm0 18c-1.41 0-2.73-.35-3.88-.96l-.28-.15-2.89.44.44-2.89-.15-.28C4.35 14.73 4 13.41 4 12c0-4.41 3.59-8 8-8s8 3.59 8 8-3.59 8-8 8z" />
                <path
                  d="M16.5 12.5c-.28 0-.5-.22-.5-.5s.22-.5.5-.5.5.22.5.5-.22.5-.5.5m-3 0c-.28 0-.5-.22-.5-.5s.22-.5.5-.5.5.22.5.5-.22.5-.5.5m-3 0c-.28 0-.5-.22-.5-.5s.22-.5.5-.5.5.22.5.5-.22.5-.5.5" />
              </svg>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</footer>
